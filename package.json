{
  "name": "cswap-vscode",
  "displayName": "CSwap — Claude Account Switcher",
  "description": "Add, list, remove and quickly swap between Claude Code accounts using cswap. Shows live usage details per account, auto-reloads the window and closes Claude terminals on switch.",
  "version": "0.1.9",
  "publisher": "MadCowTM",
  "author": "MadCowTM",
  "license": "MIT",
  "icon": "media/plugin-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/milan-s/cswap-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/milan-s/cswap-vscode/issues"
  },
  "homepage": "https://github.com/milan-s/cswap-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "cswap",
    "account",
    "switcher",
    "anthropic"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "claude-logo": {
        "description": "Claude logomark",
        "default": {
          "fontPath": "media/claude-icons.woff",
          "fontCharacter": "\\F101"
        }
      }
    },
    "configuration": {
      "title": "CSwap",
      "properties": {
        "cswap.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the cswap executable. Leave empty to auto-detect (PATH, ~/.local/bin/cswap)."
        },
        "cswap.refreshIntervalSeconds": {
          "type": "number",
          "default": 0,
          "description": "Auto-refresh the account list every N seconds. Set to 0 to disable (refresh manually). cswap caches usage data, so polling is cheap."
        },
        "cswap.autoReloadWindow": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reload the VS Code window after switching accounts, without prompting."
        },
        "cswap.closeClaudeTerminals": {
          "type": "boolean",
          "default": false,
          "description": "Close any open terminals whose name contains 'claude' before reloading the window after an account switch."
        }
      }
    },
    "commands": [
      {
        "command": "cswap.swap",
        "title": "CSwap: Swap Claude Account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "cswap.refresh",
        "title": "CSwap: Refresh Accounts",
        "icon": "$(refresh)"
      },
      {
        "command": "cswap.addCurrent",
        "title": "CSwap: Add Current Account",
        "icon": "$(add)"
      },
      {
        "command": "cswap.addToken",
        "title": "CSwap: Add Account from OAuth Token",
        "icon": "$(key)"
      },
      {
        "command": "cswap.switchToItem",
        "title": "CSwap: Switch to This Account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "cswap.removeItem",
        "title": "CSwap: Remove This Account",
        "icon": "$(trash)"
      },
      {
        "command": "cswap.expandUsage",
        "title": "CSwap: Show Usage Details",
        "icon": "$(expand-all)"
      },
      {
        "command": "cswap.collapseUsage",
        "title": "CSwap: Hide Usage Details",
        "icon": "$(collapse-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cswap",
          "title": "Claude Accounts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cswap": [
        {
          "id": "cswapAccounts",
          "name": "Accounts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cswapAccounts",
        "contents": "No Claude accounts are managed yet.\n[Add Current Account](command:cswap.addCurrent)\n[Add from OAuth Token](command:cswap.addToken)\n\nIf cswap is not installed, see the [cswap docs](https://pypi.org/project/claude-swap/)."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cswap.addCurrent",
          "when": "view == cswapAccounts",
          "group": "navigation@1"
        },
        {
          "command": "cswap.addToken",
          "when": "view == cswapAccounts",
          "group": "navigation@2"
        },
        {
          "command": "cswap.refresh",
          "when": "view == cswapAccounts",
          "group": "navigation@3"
        },
        {
          "command": "cswap.expandUsage",
          "when": "view == cswapAccounts && !cswap.usageExpanded",
          "group": "navigation@4"
        },
        {
          "command": "cswap.collapseUsage",
          "when": "view == cswapAccounts && cswap.usageExpanded",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "cswap.switchToItem",
          "when": "view == cswapAccounts && viewItem == cswapAccount",
          "group": "inline@1"
        },
        {
          "command": "cswap.removeItem",
          "when": "view == cswapAccounts && viewItem == cswapAccount",
          "group": "inline@2"
        },
        {
          "command": "cswap.switchToItem",
          "when": "view == cswapAccounts && viewItem == cswapAccount",
          "group": "1_actions@1"
        },
        {
          "command": "cswap.removeItem",
          "when": "view == cswapAccounts && viewItem == cswapAccount",
          "group": "1_actions@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "fantasticon": "^4.1.0",
    "typescript": "^5.4.0"
  }
}
